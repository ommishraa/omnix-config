{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "nixos_small",
        "padding": {
            "top": 1,
            "left": 2,
            "right": 1
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "blue",
            "title": "green"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        "separator",
        {
            "type": "os",
            "key": "󱄅  os",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "  kernel",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "  wm",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "  shell",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "  term",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "  uptime",
            "keyColor": "blue",
            "format": "{2}h {3}m"
        },
        {
            "type": "command",
            "key": "  age",
            "keyColor": "blue",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); days=$(( (current - birth_install) / 86400 )); echo $days days"
        },
        "separator",
        {
            "type": "cpu",
            "key": "  cpu",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "󰾲  gpu",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": "  ram",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key": "  disk",
            "keyColor": "yellow",
            "folders": "/"
        },
        "separator",
        {
            "type": "packages",
            "key": "  pkgs",
            "keyColor": "magenta"
        },
        "separator",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        },
        "break"
    ]
}
