# yazi/keymap.toml
# omnix-config — vim-style keybinds

[manager]
keymap = [
  # ── Navigation ──────────────────────────────────────────
  { on = "k",         run = "arrow -1",              desc = "Up" },
  { on = "j",         run = "arrow 1",               desc = "Down" },
  { on = "h",         run = "leave",                 desc = "Go to parent" },
  { on = "l",         run = "enter",                 desc = "Enter directory / open file" },
  { on = "K",         run = "arrow -5",              desc = "Up 5" },
  { on = "J",         run = "arrow 5",               desc = "Down 5" },
  { on = "g g",       run = "arrow -99999999",       desc = "Top" },
  { on = "G",         run = "arrow 99999999",        desc = "Bottom" },
  { on = "<Up>",      run = "arrow -1",              desc = "Up" },
  { on = "<Down>",    run = "arrow 1",               desc = "Down" },
  { on = "<Left>",    run = "leave",                 desc = "Go to parent" },
  { on = "<Right>",   run = "enter",                 desc = "Enter" },

  # ── Go to directories ────────────────────────────────────
  { on = "g h",       run = "cd ~",                  desc = "Home" },
  { on = "g c",       run = "cd ~/.config",          desc = "Config" },
  { on = "g d",       run = "cd ~/Downloads",        desc = "Downloads" },
  { on = "g o",       run = "cd ~/om-works",         desc = "om-works" },
  { on = "g n",       run = "cd ~/om-works/omnix-config", desc = "omnix-config" },

  # ── Selection ────────────────────────────────────────────
  { on = "<Space>",   run = "select --state=none",   desc = "Toggle selection" },
  { on = "v",         run = "visual_mode",           desc = "Visual mode" },
  { on = "V",         run = "select_all --state=none", desc = "Select all" },

  # ── File operations ──────────────────────────────────────
  { on = "o",         run = "open",                  desc = "Open" },
  { on = "<Enter>",   run = "open",                  desc = "Open" },
  { on = "O",         run = "open --interactive",    desc = "Open interactively" },
  { on = "e",         run = "open --interactive",    desc = "Open with editor" },
  { on = "y",         run = "yank",                  desc = "Yank (copy)" },
  { on = "Y",         run = "unyank",                desc = "Cancel yank" },
  { on = "x",         run = "yank --cut",            desc = "Cut" },
  { on = "p",         run = "paste",                 desc = "Paste" },
  { on = "P",         run = "paste --force",         desc = "Paste (overwrite)" },
  { on = "d",         run = "remove",                desc = "Trash" },
  { on = "D",         run = "remove --permanently",  desc = "Delete permanently" },
  { on = "a",         run = "create",                desc = "Create file/dir" },
  { on = "r",         run = "rename --cursor=before_ext", desc = "Rename" },
  { on = "c",         run = "copy path",             desc = "Copy path" },

  # ── Search ───────────────────────────────────────────────
  { on = "/",         run = "find --smart",          desc = "Search" },
  { on = "n",         run = "find_arrow",            desc = "Next match" },
  { on = "N",         run = "find_arrow --previous", desc = "Prev match" },
  { on = "f",         run = "filter --smart",        desc = "Filter" },
  { on = "s",         run = "shell --block --confirm 'fd . | fzf | xargs -I{} yazi {}' ", desc = "FZF search" },

  # ── Sorting ──────────────────────────────────────────────
  { on = "S m",       run = "sort modified --dir-first",   desc = "Sort by modified" },
  { on = "S n",       run = "sort natural --dir-first",    desc = "Sort natural" },
  { on = "S s",       run = "sort size --dir-first",       desc = "Sort by size" },
  { on = "S e",       run = "sort extension --dir-first",  desc = "Sort by ext" },

  # ── View ─────────────────────────────────────────────────
  { on = ".",         run = "hidden toggle",         desc = "Toggle hidden files" },
  { on = "z",         run = "plugin zoxide",         desc = "Zoxide jump" },
  { on = "Z",         run = "plugin fzf",            desc = "FZF jump" },
  { on = "t",         run = "tab_create --current",  desc = "New tab" },
  { on = "T",         run = "tab_close",             desc = "Close tab" },
  { on = "[",         run = "tab_switch -1 --relative", desc = "Prev tab" },
  { on = "]",         run = "tab_switch 1 --relative",  desc = "Next tab" },

  # ── Shell ────────────────────────────────────────────────
  { on = "!",         run = "shell --block --confirm", desc = "Shell" },
  { on = "w",         run = "shell --block --confirm 'kitty &'", desc = "Open terminal here" },

  # ── Misc ─────────────────────────────────────────────────
  { on = "q",         run = "quit",                  desc = "Quit" },
  { on = "<Esc>",     run = "escape",                desc = "Escape" },
  { on = "R",         run = "refresh",               desc = "Refresh" },
  { on = "?",         run = "help",                  desc = "Help" },
]

[tasks]
keymap = [
  { on = "<Esc>", run = "close", desc = "Close" },
  { on = "w",     run = "close", desc = "Close" },
  { on = "k",     run = "arrow -1", desc = "Up" },
  { on = "j",     run = "arrow 1",  desc = "Down" },
]

[select]
keymap = [
  { on = "<Esc>",   run = "close",          desc = "Cancel" },
  { on = "<Enter>", run = "close --submit", desc = "Submit" },
  { on = "k",       run = "arrow -1",       desc = "Up" },
  { on = "j",       run = "arrow 1",        desc = "Down" },
]

[input]
keymap = [
  { on = "<Enter>", run = "close --submit", desc = "Submit" },
  { on = "<Esc>",   run = "close",          desc = "Cancel" },
  { on = "<C-c>",   run = "close",          desc = "Cancel" },
  { on = "<Left>",  run = "move -1",        desc = "Left" },
  { on = "<Right>", run = "move 1",         desc = "Right" },
  { on = "<C-a>",   run = "move -999",      desc = "Start" },
  { on = "<C-e>",   run = "move 999",       desc = "End" },
  { on = "<Backspace>", run = "backspace",  desc = "Backspace" },
]

[confirm]
keymap = [
  { on = "<Esc>",   run = "close",          desc = "Cancel" },
  { on = "n",       run = "close",          desc = "No" },
  { on = "<Enter>", run = "close --submit", desc = "Yes" },
  { on = "y",       run = "close --submit", desc = "Yes" },
]